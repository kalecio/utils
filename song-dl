#!/usr/bin/env python3

import sys
import shutil
import subprocess
from pathlib import Path
import argparse
from urllib.parse import urlparse

def load_yt_dlp():
    """Import yt_dlp from the interpreter used by the yt-dlp command, if needed."""
    try:
        import yt_dlp
        return yt_dlp
    except ImportError:
        executable = shutil.which("yt-dlp")
        if not executable:
            return None

        # Homebrew and pipx commonly install yt-dlp in an isolated Python
        # environment, separate from the interpreter running this script.
        resolved = Path(executable).resolve()
        try:
            with resolved.open(encoding="utf-8") as stream:
                shebang = stream.readline().strip()
            interpreter = shebang[2:].split()[0] if shebang.startswith("#!") else None
            if interpreter:
                paths = subprocess.check_output(
                    [interpreter, "-c", "import sys; print('\n'.join(sys.path))"],
                    text=True,
                ).splitlines()
                for path in paths:
                    if path and path not in sys.path:
                        sys.path.append(path)
                import yt_dlp
                return yt_dlp
        except (OSError, subprocess.CalledProcessError, ImportError, IndexError):
            pass
        return None

def is_installed(binary):
    return shutil.which(binary) is not None

def ensure_yt_dlp():
    if load_yt_dlp() is None:
        print("\n❌ yt-dlp is required but not installed in this Python environment.\n")
        print("Install it with one of the following:\n")
        print("👉 pipx install yt-dlp")
        print("👉 python3 -m venv venv && source venv/bin/activate && pip install yt-dlp\n")
        sys.exit(1)

def ensure_ffmpeg():
    if not is_installed("ffmpeg"):
        print("\n❌ FFmpeg is required but not installed.\n")
        print("Install it from:")
        print("👉 https://ffmpeg.org/download.html\n")
        print("After installing, make sure it's available in your PATH.")
        sys.exit(1)

def browser_cookie_options(browser):
    if browser:
        return {'cookiesfrombrowser': (browser,)}
    return {}

def default_browser_for_url(url):
    host = (urlparse(url).hostname or '').lower().rstrip('.')
    if host == 'youtube.com' or host.endswith('.youtube.com') or host == 'youtu.be' or host.endswith('.youtu.be'):
        return 'chrome'
    return None

def detect_playlist(url, browser=None):
    yt_dlp = load_yt_dlp()
    options = {
        'quiet': True,
        'extract_flat': True,
        **browser_cookie_options(browser),
    }
    with yt_dlp.YoutubeDL(options) as ydl:
        info = ydl.extract_info(url, download=False)
        if 'entries' in info:
            return True, info.get('title', 'playlist')
        return False, None

def download_audio(url, is_playlist, playlist_title=None, browser=None):
    yt_dlp = load_yt_dlp()
    if is_playlist:
        outtmpl = f"{playlist_title}/%(uploader)s - %(title)s.%(ext)s"
    else:
        outtmpl = "%(uploader)s - %(title)s.%(ext)s"

    ydl_opts = {
        'format': 'bestaudio/best',
        'outtmpl': outtmpl,
        'writethumbnail': True,
        'addmetadata': True,
        'postprocessors': [
            {
                'key': 'FFmpegExtractAudio',
                'preferredcodec': 'mp3',
                'preferredquality': '0',
            },
            {
                'key': 'FFmpegMetadata',
            },
        ],
        'noplaylist': not is_playlist,
        **browser_cookie_options(browser),
    }

    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        ydl.download([url])

def main():
    parser = argparse.ArgumentParser(
        description='Download audio as MP3. Chrome cookies are used automatically for YouTube URLs.'
    )
    parser.add_argument(
        '--cookies-from-browser',
        metavar='BROWSER',
        help='explicitly read signed-in cookies from a browser for any supported URL',
    )
    parser.add_argument('urls', nargs='+', metavar='URL')
    args = parser.parse_args()

    ensure_yt_dlp()
    ensure_ffmpeg()

    for url in args.urls:
        print(f"\n🔗 Processing: {url}")
        print("🔍 Detecting URL type...")

        browser = args.cookies_from_browser or default_browser_for_url(url)
        is_playlist, playlist_title = detect_playlist(url, browser)

        if is_playlist:
            print(f"📂 Playlist detected: {playlist_title}")
        else:
            print("🎵 Single video detected")

        download_audio(url, is_playlist, playlist_title, browser)

if __name__ == "__main__":
    main()
